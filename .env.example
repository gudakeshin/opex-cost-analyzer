MAX_UPLOAD_MB=50

# API authentication — REQUIRED for any deployment reachable beyond localhost.
# Tokens are comma-separated "principal:token" pairs (or bare tokens).
# Resources created by a principal are invisible to other principals.
AUTH_ENABLED=false
# API_AUTH_TOKENS=alice:generate-a-long-random-token-here

# ⚠️  NEVER commit real API keys. Replace placeholders below with your own keys.
ANTHROPIC_API_KEY=sk-ant-api03-<your-anthropic-api-key-here>

# Gemini provider (replaces Claude when LLM_PROVIDER=gemini)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash       # override if the model ID differs
LLM_PROVIDER=gemini                  # "gemini" | "anthropic" — auto-selects gemini when GEMINI_API_KEY is set
ANTHROPIC_MODEL=claude-sonnet-4-6    # default Claude model when LLM_PROVIDER=anthropic
LLM_CHAT_SYNTHESIS_ENABLED=true      # LLM writes chat answers (provider-agnostic, Claude default); set false to force the deterministic keyword composer

# Qdrant vector memory — self-hosted (see docker-compose.yml for local setup)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                   # Leave blank for local; set for cloud/secured deployment
QDRANT_ENABLED=true
EMBEDDING_MODEL=all-MiniLM-L6-v2     # Local model, no API cost

# Rate limiting & timeouts
RATE_LIMIT_ENABLED=true               # master switch — leave true in any shared deployment
RATE_LIMIT_DEFAULT=300/minute         # all routes without a stricter per-route limit
RATE_LIMIT_LLM=10/minute              # chat/analyze endpoints that trigger LLM calls
RATE_LIMIT_UPLOAD=30/minute           # document upload/reprocess endpoints
OPAR_TIMEOUT_SECONDS=240              # full chat/analysis loop (agent + reflect synthesis)
LLM_SYNTHESIS_TIMEOUT_SECONDS=90      # standard Claude advisory/chat synthesis
LLM_THINKING_TIMEOUT_SECONDS=180        # extended-thinking synthesis (Thinking: on)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Optional Redis — distributed manifest locking + session/progress stores (multi-worker production)
# REDIS_URL=redis://localhost:6379/0

# LlamaParse — multimodal PDF/DOCX parsing (https://cloud.llamaindex.ai/)
LLAMA_CLOUD_API_KEY=your-llama-cloud-api-key-here
LLAMAPARSE_ENABLED=true
LLAMAPARSE_RESULT_TYPE=markdown
LLAMAPARSE_PREMIUM_MODE=false


# ---------------------------------------------------------------------------
# Advanced / optional — every setting below is commented out at its default.
# ---------------------------------------------------------------------------

# Storage
# OPEX_DATA_DIR=./data                 # all runtime state (tests point this at a temp dir)
# REPOSITORY_BACKEND=sqlite            # "sqlite" | "json" (legacy file manifests)
# SQLITE_DB_PATH=./data/opex.db
# SESSION_TTL_DAYS=30
# CLEANUP_INTERVAL_HOURS=24
# LOG_LEVEL=INFO

# LLM behaviour
# LLM_MODE=M2                          # M1 deterministic only | M2 managed API | M3 on-prem (Ollama)
# OLLAMA_URL=http://localhost:11434    # used when LLM_MODE=M3
# OLLAMA_MODEL=llama3
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5    # cheap calls (intent classification etc.)
# ANTHROPIC_AGENT_MODEL=claude-sonnet-4-6  # agent/tool-use loop
# LLM_TEMPERATURE=                     # unset = provider default; lower = more repeatable narratives
# LLM_TRUNCATION_RETRY_MAX_TOKENS=8192 # ceiling for the one automatic retry when a reply is cut off
# LLM_INTENT_CLASSIFICATION_ENABLED=true
# WORKBOOK_LLM_INTERPRET=              # 1 = always use the LLM to interpret workbook structure

# Agent loop and timeouts
# AGENT_CONTROLLER_ENABLED=true
# AGENT_MAX_TOOL_ITERATIONS=12
# PER_SKILL_TIMEOUT_SECONDS=30
# WORKBENCH_TIMEOUT_SECONDS=180
# ANALYST_TIMEOUT_SECONDS=240

# Document retrieval (RAG)
# DOC_RAG_ENABLED=true                 # false = skip chunk indexing/retrieval

# Regulatory watcher
# REG_WATCHER_LIVE=                    # 1 = use live HTTP feeds instead of the sample catalogue

# Licensed India benchmark feeds — integration stubs, not on any live path (see docs/known_stubs.md)
# CMIE_API_KEY=
# CAPITALINE_API_KEY=
# CRISIL_API_KEY=
