[
  {"kpi_id": "ebitda_per_tonne", "kpi_name": "EBITDA per Tonne of Cement", "unit": "inr_per_t", "formula": "ebitda_inr / cement_sales_t", "target_direction": "higher", "p50_benchmark": 850},
  {"kpi_id": "specific_heat_consumption", "kpi_name": "Specific Heat Consumption", "unit": "kcal_per_kg_clinker", "formula": "thermal_energy_kcal / clinker_production_kg", "target_direction": "lower", "p50_benchmark": 730},
  {"kpi_id": "specific_power_consumption", "kpi_name": "Specific Electrical Power Consumption", "unit": "kwh_per_t_cement", "formula": "electricity_kwh / cement_production_t", "target_direction": "lower", "p50_benchmark": 73},
  {"kpi_id": "clinker_factor", "kpi_name": "Clinker Factor", "unit": "pct", "formula": "clinker_consumed_t / cement_produced_t * 100", "target_direction": "lower", "p50_benchmark_pct": 68.0},
